    {
      "match": "^\\s*(<\\?php|\\?>)\\s*$",
      "captures": {
        "1": {
          "name": "punctuation.section.embedded.sharp"
        }
      }
    },
    {
      "match": "^\\s*(//.*)$",
      "captures": {
        "1": {
          "name": "comment.line.double-slash.sharp"
        }
      }
    },
    {
      "include": "#script"
    },
    {
      "match": "^\\s*(@endscript)\\s*$",
