    "script": {
      "comment": "while, not end: whatever PHP is left open, @endscript still ends it",
      "begin": "^\\s*(@script)\\s*$",
      "while": "^(?!\\s*@endscript\\s*$)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.section.sharp"
