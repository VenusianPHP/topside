{
    "name": "venusian-surface/rendering",
    "description": "The Venusian Topside Rendering Component",
    "keywords": [
        "venusian",
        "surface",
        "drawing",
        "rendering",
        "software-renderer"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/surface/0.11.x/drawing",
    "support": {
        "issues": "https://github.com/VenusianPHP/surface/issues",
        "source": "https://github.com/venusian-surface/drawing"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "venusian-surface/contracts": "^0.11.0",
        "venusian-surface/nuts-and-bolts": "^0.11.0",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "suggest": {
        "php-io-extensions/comrec": "(^0.11.0) -Optimized Drawing Command Recorder"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Surface\\Rendering\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Rendering\\RenderingServiceProvider"
            ]
        }
    }
}
