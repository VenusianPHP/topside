{
    "name": "venusian-surface/toolkits",
    "description": "Surface toolkits: windows, views, menus and the toolkit sessions native adapters drive.",
    "keywords": [
        "venusian",
        "surface",
        "topside",
        "toolkits",
        "gui",
        "menus"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/topside/0.11.x/toolkits",
    "support": {
        "issues": "https://github.com/VenusianPHP/topside/issues",
        "source": "https://github.com/venusian-surface/toolkits"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "venusian-surface/contracts": "^0.11.0",
        "venusian-surface/nuts-and-bolts": "^0.11.0",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/io-pools": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0",
        "venusian-voyager/pipeline": "^0.11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Surface\\Toolkits\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        }
    }
}
