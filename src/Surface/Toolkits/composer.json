{
    "name": "venusian-surface/toolkits",
    "description": "The Topside Surface Toolkits Component.",
    "keywords": [
        "venusian",
        "surface",
        "bridge",
        "toolkit",
        "appkit",
        "gtk",
        "qt"
    ],
    "license": "MIT",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/topside/0.11.x/bridge",
    "support": {
        "issues": "https://github.com/VenusianPHP/topside/issues",
        "source": "https://github.com/venusian-topside/bridge"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "venusian-surface/contracts": "^0.11.0",
        "venusian-voyager/contracts": "^0.11.0",
        "venusian-voyager/io-pools": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "suggest": {
        "jovian/venusian-appkit": "^0.11.0 - To bridge to AppKit and open AppKit windows on macOS.",
        "jovian/venusian-gtk": "^0.11.0 - To bridge to GTK 4 and open GTK windows on Linux or macOS.",
        "jovian/venusian-qt": "^0.11.0 - To bridge to Qt 6 and open Qt windows on Linux or macOS."
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Surface\\Toolkits\\": ""
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Toolkits\\ToolkitServiceProvider"
            ]
        }
    }
}
