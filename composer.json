{
    "name": "venusian/topside",
    "description": "The Venusian Visual Output Framework.",
    "keywords": [
        "framework",
        "venusian",
        "scrapyard-io",
        "display",
        "framebuffer"
    ],
    "license": "MIT",
    "version": "0.11.5",
    "homepage": "https://venusian.projectsaturnstudios.com/ecosystem/venusian/topside/0.11.x",
    "support": {
        "issues": "https://github.com/VenusianPHP/topside/issues",
        "source": "https://github.com/VenusianPHP/topside"
    },
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "~8.4.27||^8.5.12",
        "gpio/contracts": "^0.11.0",
        "venusian-voyager/console": "^0.11.0",
        "venusian-voyager/filesystem": "^0.11.0",
        "venusian-voyager/io-pools": "^0.11.0",
        "venusian-voyager/nuts-and-bolts": "^0.11.0"
    },
    "replace": {
        "venusian-surface/toolkits": "self.version",
        "venusian-surface/contracts": "self.version",
        "venusian-surface/nuts-and-bolts": "self.version"
    },
    "suggest": {},
    "require-dev": {
        "pestphp/pest": "^4"
    },
    "autoload": {
        "psr-4": {
            "Surface\\": "src/Surface"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Venusian\\Topside\\Tests\\": "tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "providers": [
                "Surface\\Core\\Providers\\TopsideServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
